---
layout: layouts/base.njk
pagination:
  data: articles
  size: 1
  alias: article
permalink: "/blog/{{ article.slug }}/index.html"
locale: en
eleventyComputed:
  title: "{{ article.title }} | CHAIC"
  description: "{{ article.excerpt }}"
  canonicalUrl: "{{ site.origin }}/blog/{{ article.slug }}/"
  image: "{{ article.image }}"
  imageAlt: "{{ article.title }}"
  imageWidth: 1536
  imageHeight: 1024
ogType: article
indexable: true
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.origin }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Insights",
      "item": "{{ site.origin }}/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json | safe }},
      "item": "{{ site.origin }}/blog/{{ article.slug }}/"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "{{ site.origin }}/blog/{{ article.slug }}/#article",
  "headline": {{ article.title | json | safe }},
  "description": {{ article.excerpt | json | safe }},
  "image": [{{ article.image | json | safe }}],
  "datePublished": "{{ article.datePublished }}",
  "dateModified": "{{ article.dateModified }}",
  "mainEntityOfPage": "{{ site.origin }}/blog/{{ article.slug }}/",
  "inLanguage": "en",
  "author": {
    "@type": "Organization",
    "name": "Caribbean Health AI Congress",
    "url": "{{ site.origin }}/"
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.fullName | json | safe }},
    "url": "{{ site.origin }}/",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ '/images/logos/CHAIC-Logo.png' | absolute(site.origin) }}"
    }
  }
}
</script>
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/blog/">Insights</a></li>
    <li><span aria-current="page">{{ article.title }}</span></li>
  </ol>
</nav>
<article class="blog-post">
  <header class="article-header section-shell">
    <p class="eyebrow">CHAIC insight</p>
    <h1>{{ article.title }}</h1>
    <p class="article-deck">{{ article.excerpt }}</p>
    <div class="article-byline">
      <span>{{ i18n.en.labels.author }} Caribbean Health AI Congress</span>
      <span>{{ i18n.en.labels.published }} <time datetime="{{ article.datePublished }}">{{ article.datePublished | readableDate("en") }}</time></span>
      <span>{{ i18n.en.labels.modified }} <time datetime="{{ article.dateModified }}">{{ article.dateModified | readableDate("en") }}</time></span>
    </div>
  </header>
  <figure class="article-hero-image section-shell"><img src="{{ article.image }}" width="1536" height="1024" alt="{{ article.title }}" fetchpriority="high"></figure>
  <div class="article-layout section-shell">
    <div class="article-content">{{ article.content | safe }}</div>
    <aside class="article-aside">
      <h2>Continue the conversation at CHAIC</h2>
      <p>Meet healthcare leaders working through these questions in San Juan on September 25–26.</p>
      <a class="button button-primary" href="{{ event.lumaUrl }}?utm_source=chaicpr.com&amp;utm_medium=website&amp;utm_campaign=chaic_2026&amp;utm_content=blog_{{ article.slug }}" data-checkout data-pass-id="general" data-cta-location="blog_article" data-article-slug="{{ article.slug }}" data-label="Register for CHAIC">Register for CHAIC</a>
    </aside>
  </div>
  <footer class="article-notes section-shell">
    <h2>{{ i18n.en.labels.disclosure }}</h2>
    <p>{{ article.approval.disclosure }}</p>
    {% if article.approval.sources.length %}
      <h2>{{ i18n.en.labels.sources }}</h2>
      <ul>{% for source in article.approval.sources %}<li><a href="{{ source.url }}">{{ source.name }}</a></li>{% endfor %}</ul>
    {% endif %}
  </footer>
</article>
<section class="related section">
  <div class="section-shell">
    <div class="section-heading">
      <div><p class="eyebrow">Keep exploring</p><h2>Related healthcare AI insights</h2></div>
      <a class="text-link" href="/blog/">Browse all insights →</a>
    </div>
    <div class="article-grid">
      {% for relatedArticle in articles | withoutSlug(article.slug) | limit(3) %}
        <article class="article-card">
          <a class="article-image" href="/blog/{{ relatedArticle.slug }}/" tabindex="-1" aria-hidden="true">
            <img src="{{ relatedArticle.image }}" width="1536" height="1024" alt="" loading="lazy" decoding="async">
          </a>
          <div>
            <p class="article-date"><time datetime="{{ relatedArticle.datePublished }}">{{ relatedArticle.datePublished | readableDate("en") }}</time></p>
            <h3><a href="/blog/{{ relatedArticle.slug }}/">{{ relatedArticle.title }}</a></h3>
            <p>{{ relatedArticle.excerpt }}</p>
            <a class="text-link" href="/blog/{{ relatedArticle.slug }}/">Read article <span aria-hidden="true">→</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
