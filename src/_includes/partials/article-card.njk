<article class="article-card">
  <a class="article-image" href="/blog/{{ article.slug }}/" tabindex="-1" aria-hidden="true">
    <img src="{{ article.image }}" width="1536" height="1024" alt="" loading="lazy" decoding="async">
  </a>
  <div>
    <p class="article-date"><time datetime="{{ article.datePublished }}">{{ article.datePublished | readableDate(locale) }}</time></p>
    <h2><a href="/blog/{{ article.slug }}/">{{ article.title }}</a></h2>
    <p>{{ article.excerpt }}</p>
    <a class="text-link" href="/blog/{{ article.slug }}/">{{ 'Read article' if locale == 'en' else 'Leer artículo' }} <span aria-hidden="true">→</span></a>
  </div>
</article>
