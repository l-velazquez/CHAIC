<picture class="workshop-picture">
  <source type="image/avif" srcset="/assets/media/workshop-640.avif 640w, /assets/media/workshop-1200.avif 1200w" sizes="{{ workshopSizes or '100vw' }}">
  <source type="image/webp" srcset="/assets/media/workshop-640.webp 640w, /assets/media/workshop-1200.webp 1200w, /images/assets/workshop-hero-image.webp 1584w" sizes="{{ workshopSizes or '100vw' }}">
  <img src="/images/assets/workshop-hero-image.webp" width="1584" height="672" alt="{{ workshopAlt or '' }}" {{ 'loading="lazy" decoding="async"' | safe if workshopLazy else 'fetchpriority="high"' | safe }}>
</picture>
